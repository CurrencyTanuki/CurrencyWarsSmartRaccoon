    "羁绊装备": "bond_equipment",
    "流派星徽": "style_emblem",
    "阵营星徽": "faction_emblem",
    "钻石": "gem_material",
    "宝钻": "wealth_gem",
    "消耗品": "consumable",
    "武装箱": "armament_box",
    "特殊道具": "special_item",
    "？": "special_material",
    "？？？": "special_material"
  }
}
