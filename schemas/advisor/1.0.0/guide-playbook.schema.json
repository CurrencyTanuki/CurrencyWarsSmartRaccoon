{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://currency-wars.local/schemas/advisor/1.0.0/guide-playbook.schema.json",
  "title": "Currency Wars Advisor guide playbook",
  "type": "object",
  "required": [
    "schemaVersion", "guideId", "title", "archetypeId", "archetypeName",
    "applicableGameVersion", "goalIds", "signals", "rules", "sources"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "guideId": { "$ref": "#/$defs/nonEmpty" },
    "title": { "$ref": "#/$defs/nonEmpty" },
    "archetypeId": { "$ref": "#/$defs/nonEmpty" },
    "archetypeName": { "$ref": "#/$defs/nonEmpty" },
    "applicableGameVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "goalIds": { "$ref": "#/$defs/stringSet" },
    "signals": {
      "type": "object",
      "required": ["coreCharacterIds", "optionalCharacterIds", "synergyIds"],
      "properties": {
        "coreCharacterIds": { "$ref": "#/$defs/stringList" },
        "optionalCharacterIds": { "$ref": "#/$defs/stringList" },
        "synergyIds": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "prohibitedConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "notes": { "$ref": "#/$defs/stringList" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "condition": {
      "type": "object",
      "required": ["field", "operator", "expectedValues", "unknownPolicy"],
      "properties": {
        "field": { "$ref": "#/$defs/nonEmpty" },
        "operator": { "$ref": "#/$defs/nonEmpty" },
        "expectedValues": { "$ref": "#/$defs/stringSet" },
        "unknownPolicy": { "enum": ["reject", "acceptWithPenalty", "requireReview"] },
        "sourceId": { "type": ["string", "null"] },
        "locator": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["sourceId", "locator"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmpty" },
        "locator": { "$ref": "#/$defs/nonEmpty" },
        "summary": { "type": ["string", "null"] },
        "capturedAt": { "type": ["string", "null"], "format": "date-time" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "ruleId", "title", "action", "conditions", "benefits", "costs",
        "risks", "preconditions", "invalidatesWhen", "sources"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "action": { "$ref": "#/$defs/nonEmpty" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "benefits": { "$ref": "#/$defs/stringList" },
        "costs": { "$ref": "#/$defs/stringList" },
        "risks": { "$ref": "#/$defs/stringList" },
        "preconditions": { "$ref": "#/$defs/stringList" },
        "invalidatesWhen": { "$ref": "#/$defs/stringList" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "sourceId", "title", "author", "platform", "url", "publishedAt",
        "accessedAt", "contentType", "applicableGameVersion", "copyrightStatus"
      ],
      "properties": {
        "sourceId": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "author": { "$ref": "#/$defs/nonEmpty" },
        "platform": { "$ref": "#/$defs/nonEmpty" },
        "url": { "type": "string", "format": "uri" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "accessedAt": { "type": "string", "format": "date-time" },
        "contentType": { "$ref": "#/$defs/nonEmpty" },
        "applicableGameVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "copyrightStatus": { "enum": ["linked_only", "permission_granted", "public_domain", "synthetic"] }
      },
      "additionalProperties": false
    }
  }
}
