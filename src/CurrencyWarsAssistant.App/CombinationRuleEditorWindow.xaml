<Window x:Class="CurrencyWarsAssistant.App.CombinationRuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加组合规则"
        Width="540"
        Height="310"
        MinWidth="540"
        MinHeight="310"
        MaxWidth="540"
        MaxHeight="310"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="20"
                   FontWeight="SemiBold"
                   Text="添加禁止共存组合" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,16"
                   Foreground="{StaticResource MutedBrush}"
                   Text="两个条件分别出现不会触发；只有同时出现时才判定本局需要刷掉。"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="条件 A" />
            <ComboBox x:Name="FirstCondition"
                      Grid.Column="1"
                      MinHeight="36"
                      Padding="7,4"
                      DisplayMemberPath="Label"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Label" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="条件 B" />
            <ComboBox x:Name="SecondCondition"
                      Grid.Column="1"
                      MinHeight="36"
                      Padding="7,4"
                      DisplayMemberPath="Label"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Label" />
        </Grid>

        <TextBlock x:Name="ValidationMessage"
                   Grid.Row="4"
                   Margin="80,10,0,0"
                   Foreground="#FCA5A5"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="82"
                    Click="OnCancelClick"
                    Content="取消" />
            <Button MinWidth="110"
                    Margin="0"
                    Click="OnAddClick"
                    Content="添加规则" />
        </StackPanel>
    </Grid>
</Window>
