{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "currency-wars://schemas/game-data/1.0.0/equipment/raw",
  "title": "Currency Wars upstream equipment export",
  "type": "object",
  "required": ["metadata", "records"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["game_version", "record_count"],
      "properties": {
        "game_version": { "const": "4.4" },
        "record_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "equipment_type",
          "equippable",
          "occupies_equipment_slot",
          "base_attributes",
          "effect",
          "acquisition_methods",
          "implementation_version",
          "icon"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^currency_wars_equipment_[0-9]{3}$"
          },
          "name": { "type": "string", "minLength": 1 },
          "equipment_type": {
            "type": "string",
            "enum": [
              "简易装备",
              "进阶装备",
              "特权装备",
              "骇客改件",
              "命运改件",
              "羁绊装备",
              "流派星徽",
              "阵营星徽",
              "钻石",
              "宝钻",
              "消耗品",
              "武装箱",
              "特殊道具",
              "？",
              "？？？"
            ]
          },
          "equippable": { "type": "boolean" },
          "occupies_equipment_slot": { "type": "boolean" },
          "base_attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "value"],
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "前台强度",
                    "后台强度",
                    "生命增幅",
                    "速度增幅",
                    "伤害增幅",
                    "伤害减免",
                    "初始能量",
                    "幸运一击率",
                    "幸运一击伤害",
                    "击破效率",
                    "护盾强度",
                    "治疗强度"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]+(?:\\.[0-9]+)?%?$"
                }
              },
              "additionalProperties": true
            }
          },
          "effect": { "type": "string" },
          "acquisition_methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["method", "basis", "confidence"],
              "properties": {
                "method": { "type": "string", "minLength": 1 },
                "basis": { "type": "string", "minLength": 1 },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "verified_exact",
                    "verified_general",
                    "verified_mechanism",
                    "verified_category",
                    "mechanism_inference",
                    "source_unspecified"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "implementation_version": {
            "type": "string",
            "enum": ["3.7", "4.0", "4.2", "4.4", "页面未注明"]
          },
          "synthesis_components": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1 }
          },
          "base_equipment_name": {
            "type": ["string", "null"]
          },
          "icon": {
            "type": "object",
            "required": [
              "local_path",
              "source_url",
              "bytes",
              "sha256",
              "width",
              "height"
            ],
            "properties": {
              "local_path": { "type": "string", "minLength": 1 },
              "source_url": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
