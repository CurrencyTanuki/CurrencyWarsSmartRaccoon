<Window x:Class="CurrencyWarsAssistant.App.LogOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="币站运行日志"
        Width="860"
        MinWidth="620"
        MaxWidth="1050"
        MinHeight="112"
        MaxHeight="280"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False">
    <Grid Margin="3">
        <ItemsControl Margin="8,12,8,5"
                      IsHitTestVisible="False"
                      ItemsSource="{Binding OverlayLogLines}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="0,1"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{Binding Foreground}"
                               Text="{Binding Text}"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="3"
                                              Direction="315"
                                              Opacity="0.95"
                                              ShadowDepth="1"
                                              Color="#FF000000" />
                        </TextBlock.Effect>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Only this unobtrusive grip receives the mouse. The log text and
             empty area always pass clicks through to the game. -->
        <Border x:Name="DragGrip"
                Width="34"
                Height="9"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="4"
                Background="#55D1D5DB"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                ToolTip="拖动运行日志" />
    </Grid>
</Window>
