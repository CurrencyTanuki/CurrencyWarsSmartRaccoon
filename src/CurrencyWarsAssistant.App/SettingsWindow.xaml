<Window x:Class="CurrencyWarsAssistant.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CurrencyWarsAssistant.App"
        Title="设置"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="SettingsTabStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="18,10"
                                CornerRadius="6,6,0,0"
                                Background="#151C28"
                                BorderBrush="#344157"
                                BorderThickness="1,1,1,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#202A3B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#BCEBFF" />
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#26364C" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#62BEE8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkListRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#202A39"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#172130" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="#1D2C40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StrategyChoiceButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1B2433" />
            <Setter Property="BorderBrush" Value="#34445A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectionMode}"
                             Value="{x:Static local:AppFilterSelectionMode.Required}">
                    <Setter Property="Background" Value="#7DD3FC" />
                    <Setter Property="BorderBrush" Value="#BAE6FD" />
                    <Setter Property="Foreground" Value="#07131D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24"
                       FontWeight="Bold"
                       Text="设置" />
            <TextBlock Margin="0,5,0,16"
                       Foreground="{StaticResource MutedBrush}"
                       Text="自动流程只执行已经识别并可验证的步骤。未说明清楚的高风险操作保持关闭。" />
        </StackPanel>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="#344157"
                    BorderThickness="1">
            <TabItem Header="常规与恢复"
                     Style="{StaticResource SettingsTabStyle}">
                <StackPanel Margin="18">
                    <Border Padding="18"
                            CornerRadius="8"
                            Background="{StaticResource PanelBrush}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding ShowLogOverlay, Mode=TwoWay}"
                                      Content="自动操作时显示运行日志悬浮窗" />
                            <TextBlock Margin="23,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="界面只显示关键事件，详细记录由诊断日志控制。"
                                       TextWrapping="Wrap" />
                            <CheckBox Margin="0,18,0,0"
                                      IsChecked="{Binding EnableDiagnosticLogging, Mode=TwoWay}"
                                      Content="保存详细诊断日志" />
                            <CheckBox Margin="0,18,0,0"
                                      IsChecked="{Binding EnableUnknownPageEscapeRecovery, Mode=TwoWay}"
                                      Content="未知页面自动按 Esc 恢复（推荐）" />
                            <CheckBox Margin="0,18,0,0"
                                      IsChecked="{Binding EnableRewardStageAutomation, Mode=TwoWay}"
                                      Content="开局命中后自动完成前两层奖励关" />
                            <TextBlock Margin="23,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="关闭时仍按当前版本停在 1-1 布阵完成页面。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="奖励关角色"
                     Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="18">
                    <Border Padding="14"
                            CornerRadius="8"
                            Background="{StaticResource PanelBrush}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding EnableEarlyStrongFormationPurchase, Mode=TwoWay}"
                                      Content="自动购买并保留前期强势羁绊组件：三仙舟 + 2持续伤害（DOT）" />
                            <TextBlock Margin="23,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="默认开启，且与用户自定义名单独立。开启后这些低费羁绊组件可自动购买，且不会被下面的备战席出售策略卖掉。"
                                       TextWrapping="Wrap" />
                            <CheckBox Margin="0,14,0,0"
                                      IsChecked="{Binding EnableGalaxyScholarRewardStrategy, Mode=TwoWay}"
                                      Content="1-1 银河学者猫猫糕策略（两名不同角色必须同时上场）" />
                            <TextBlock Margin="23,7,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="默认关闭。只在 1-1 出战前尝试凑齐并上场两名银河学者；1-2 不再购买、补凑或重新触发该策略。"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,16,0,4"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="快速刷开局模式（备战页执行方式）："
                                       TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding FastRerollModeOptions}"
                                      SelectedValue="{Binding FastRerollMode, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="DisplayName"
                                      HorizontalAlignment="Left"
                                      MinWidth="220" />
                            <TextBlock Margin="23,5,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="稳定版=完整识别与验证；快速版=去掉备战页全部验证、OCR 仅识别两次、其余按内部状态机推算；极速版=备战席前三个角色无脑拖到前台、其余备战逻辑全部去掉。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            CornerRadius="8"
                            Background="{StaticResource PanelBrush}">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="布阵后自动出售备战席角色" />
                            <TextBlock Margin="0,5,0,10"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="三种策略始终只处理未上场且不在保留范围内的角色。"
                                       TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding BenchSaleModeOptions}"
                                     SelectedValuePath="Value"
                                     SelectedValue="{Binding BenchSaleMode, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     PreviewMouseWheel="OnBenchSaleModeMouseWheel"
                                     ItemContainerStyle="{StaticResource DarkListRowStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Padding="6,9"
                                                     GroupName="BenchSaleMode"
                                                     Foreground="White"
                                                     IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="White"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Margin="28,10,0,0"
                                        Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="利息阈值" />
                                <ComboBox Width="120"
                                          MinHeight="34"
                                          ItemsSource="{Binding BenchSaleInterestThresholdOptions}"
                                          SelectedItem="{Binding BenchSaleInterestThreshold, Mode=TwoWay}"
                                          IsEnabled="{Binding IsInterestBenchSaleSelected}" />
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="金币（选择第二档时生效）" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="高级设置：自定义保留与商店自动购买" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="“保留”始终优先于三档出售；“商店自动买”独立控制常规商店购买。可按角色名、费用、站位或羁绊筛选后逐项设置。"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBox Height="36"
                             Margin="0,12,0,10"
                             Padding="11,6"
                             Background="#111827"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="#3A4B65"
                             Text="{Binding CharacterAutomationRules.SearchText,
                                            UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按角色名、费用、站位或羁绊搜索" />

                    <Border CornerRadius="8"
                            Background="#111722"
                            BorderBrush="#344157"
                            BorderThickness="1">
                        <ItemsControl ItemsSource="{Binding CharacterAutomationRules.View}"
                                      Margin="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4"
                                            Padding="10,8"
                                            CornerRadius="8"
                                            Background="#18233A"
                                            BorderBrush="#344157"
                                            BorderThickness="1"
                                            MinWidth="168"
                                            MaxWidth="196">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold"
                                                       FontSize="14"
                                                       Text="{Binding Name}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding BondsLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding BondsLabel}" />
                                            <StackPanel Margin="0,7,0,0"
                                                        Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsRetained, Mode=TwoWay}"
                                                          Content="保留"
                                                          Foreground="White" />
                                                <CheckBox Margin="14,0,0,0"
                                                          IsChecked="{Binding IsAutoPurchased, Mode=TwoWay}"
                                                          Content="自动买"
                                                          Foreground="White" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
<TabItem Header="截图与识别"
                     Style="{StaticResource SettingsTabStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              PanningMode="VerticalOnly">
                    <StackPanel Margin="18">
                        <Border Padding="16"
                                CornerRadius="8"
                                Background="{StaticResource PanelBrush}">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="游戏窗口与截图器" />
                                <TextBlock Margin="0,5,0,12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="选择窗口后可截取一帧，确认分辨率适配与截图路径是否正常。"
                                           TextWrapping="Wrap" />
                                <ComboBox MinHeight="34"
                                          ItemsSource="{Binding Windows}"
                                          SelectedItem="{Binding SelectedWindow}"
                                          DisplayMemberPath="Title" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Command="{Binding RefreshWindowsCommand}"
                                            Content="重新查找窗口" />
                                    <Button Command="{Binding CaptureCommand}"
                                            Content="截取测试画面" />
                                    <Button Command="{Binding ObserveCommand}"
                                            Content="识别并判断一次" />
                                </WrapPanel>
                                <Border Height="210"
                                        Margin="0,12,0,0"
                                        Padding="6"
                                        CornerRadius="6"
                                        Background="#080C13">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="等待截图" />
                                        <Image Source="{Binding Preview}"
                                               Stretch="Uniform" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="16"
                                CornerRadius="8"
                                Background="{StaticResource PanelBrush}">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="对局截图存储" />
                                <CheckBox Margin="0,10,0,0"
                                          IsChecked="{Binding DeleteScreenshotsAfterRunCompletion, Mode=TwoWay}"
                                          Content="对局结束并生成报告后，自动删除本局截图" />
                                <TextBlock Margin="24,6,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="默认关闭。开启后仅删除 screenshots、识别失败区域和未解析图标图片；结构化 JSON、日志、节点数据与最终报告继续保留。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="16"
                                CornerRadius="8"
                                Background="{StaticResource PanelBrush}">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="诊断路径" />
                                <TextBlock Margin="0,5,0,8"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="识别异常时可从这里找到本次运行日志。"
                                           TextWrapping="Wrap" />
                                <TextBox IsReadOnly="True"
                                         Text="{Binding LogFilePath, Mode=OneWay}"
                                         TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0"
                                           Foreground="#84CFEF"
                                           Text="{Binding Status}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <Button Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="OnCloseClick"
                Content="完成" />
    </Grid>
</Window>
