<Window x:Class="CurrencyWarsAssistant.App.RerollProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CurrencyWarsAssistant.App"
        Title="编辑刷取方案"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#0F1420" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#39445B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <ItemsPanelTemplate x:Key="FilterWrapPanel">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="EditorTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3A4B65" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <UniformGrid Rows="1"
                                         Columns="4"
                                         Margin="0,0,0,8"
                                         IsItemsHost="True" />
                            <Border Grid.Row="1"
                                    CornerRadius="7"
                                    Background="#111722"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Padding="18,10"
                                CornerRadius="6"
                                Background="#171D29"
                                BorderBrush="#303A4E"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="#202A3B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#A5E5FF" />
                                <Setter TargetName="HeaderBorder"
                                        Property="Background"
                                        Value="#25364D" />
                                <Setter TargetName="HeaderBorder"
                                        Property="BorderBrush"
                                        Value="#67C9F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileChipStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="168" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#202838" />
            <Setter Property="BorderBrush" Value="#3B475F" />
            <Setter Property="ToolTip" Value="{Binding Description}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectionMode}"
                             Value="{x:Static local:AppFilterSelectionMode.Required}">
                    <Setter Property="Background" Value="#7DD3FC" />
                    <Setter Property="Foreground" Value="#07131D" />
                    <Setter Property="BorderBrush" Value="#BAE6FD" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectionMode}"
                             Value="{x:Static local:AppFilterSelectionMode.Forbidden}">
                    <Setter Property="Background" Value="#C94352" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="#EF7B88" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProfileChipTemplate">
            <Button Command="{Binding CycleSelectionCommand}"
                    Style="{StaticResource ProfileChipStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding Name}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               FontSize="11"
                               FontWeight="Bold"
                               Text="{Binding SelectionLabel}" />
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="ProfileListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemsPanel" Value="{StaticResource FilterWrapPanel}" />
            <Setter Property="ItemTemplate" Value="{StaticResource ProfileChipTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Text="刷取方案" />
            <TextBlock Margin="0,5,0,12"
                       Foreground="{StaticResource MutedBrush}"
                       Text="同一类别多选表示“任意一个”；不同类别之间必须同时满足。红色项不能出现。"
                       TextWrapping="Wrap" />
            <TextBox Style="{StaticResource EditorTextBoxStyle}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="方案名称" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="10,8"
                CornerRadius="6"
                Background="#172131"
                BorderBrush="#32445D"
                BorderThickness="1">
            <TextBlock Foreground="#A5E5FF"
                       Text="示例：长线利好 ＋（乱成一锅粥 或 采购专员·彩）＋ 不出现（灼热轰炸、时间刺客）。"
                       TextWrapping="Wrap" />
        </Border>

        <TabControl Grid.Row="2"
                    Style="{StaticResource EditorTabControlStyle}">
            <TabItem Header="投资环境"
                     Style="{StaticResource EditorTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,8"
                               Foreground="#7DD3FC"
                               Text="只支持正选；多选表示刷到其中任意一个即可。" />
                    <TextBox Grid.Row="1"
                             Margin="0,0,0,9"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Text="{Binding InvestmentEnvironments.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索投资环境" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding InvestmentEnvironments.View}"
                             Style="{StaticResource ProfileListStyle}" />
                </Grid>
            </TabItem>

            <TabItem Header="投资策略（第一位面）"
                     Style="{StaticResource EditorTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,8"
                               Foreground="#7DD3FC"
                               Text="只列出第一位面能够出现的策略；多选表示任意一个即可。" />
                    <TextBox Grid.Row="1"
                             Margin="0,0,0,9"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Text="{Binding InvestmentStrategies.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索投资策略" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding InvestmentStrategies.View}"
                             Style="{StaticResource ProfileListStyle}" />
                </Grid>
            </TabItem>

            <TabItem Header="敌人阵营"
                     Style="{StaticResource EditorTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,8"
                               Foreground="#7DD3FC"
                               Text="点击循环：深色不限制 → 浅蓝必出 → 红色刷掉。" />
                    <TextBox Grid.Row="1"
                             Margin="0,0,0,9"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Text="{Binding Competitors.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索敌人阵营" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Competitors.View}"
                             Style="{StaticResource ProfileListStyle}" />
                </Grid>
            </TabItem>

            <TabItem Header="敌人负面词条"
                     Style="{StaticResource EditorTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,8"
                               Foreground="#7DD3FC"
                               Text="浅蓝词条至少出现一个；所有红色词条都不能出现。" />
                    <TextBox Grid.Row="1"
                             Margin="0,0,0,9"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Text="{Binding EnemyAffixes.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索敌人负面词条" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding EnemyAffixes.View}"
                             Style="{StaticResource ProfileListStyle}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="#FB7185"
                       TextWrapping="Wrap" />
            <Button Grid.Column="1"
                    Margin="0,0,10,0"
                    Click="OnCancelClick"
                    Content="取消" />
            <Button Grid.Column="2"
                    Margin="0"
                    Background="#2E6F93"
                    BorderBrush="#67C9F2"
                    Click="OnSaveClick"
                    Content="保存方案" />
        </Grid>
    </Grid>
</Window>
