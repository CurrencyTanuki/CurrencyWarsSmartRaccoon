<Window x:Class="CurrencyWarsAssistant.App.DetailedHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="对局历史详细信息"
        Width="960"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="OnWindowKeyDown"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF3F7FA" />
        <SolidColorBrush x:Key="SecondaryText" Color="#FF91A3B4" />
        <SolidColorBrush x:Key="AccentText" Color="#FFE7CA82" />
        <SolidColorBrush x:Key="CoolText" Color="#FF83D4E3" />
        <SolidColorBrush x:Key="Hairline" Color="#526D8295" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#7595A7B7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LineFrame"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LineFrame" Property="BorderBrush" Value="#DDE7CA82" />
                                <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LineFrame" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="8" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="2,0"
                                                        Background="#7794A8B8"
                                                        BorderBrush="#90DCE5EC"
                                                        BorderThickness="1"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="7,2,5,2" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#7083D4E3" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentText}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="2"
            CornerRadius="9"
            Background="#FA0E1621"
            BorderBrush="#8795A7B7"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TitleDragSurface"
                        Grid.Column="0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource AccentText}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="对局历史详细信息" />
                </Border>
                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButton}"
                        Content="历史对局"
                        Margin="0,0,8,0"
                        Click="OnCompletedRunsClick" />
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource OutlineButton}"
                        Content="关闭"
                        Click="OnCloseClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <wv2:WebView2 x:Name="ReportBrowser" />
                    <TextBlock x:Name="ReportLoading"
                               Text="正在加载对局报告…"
                               Background="#FF0E1621"
                               Foreground="#FF91A3B4"
                               FontSize="13"
                               FontFamily="Microsoft YaHei UI"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               TextAlignment="Center"
                               Padding="0,40,0,0" />
                </Grid>
                <ResizeGrip Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="#A0F4F6F8" />
            </Grid>
    </Border>
</Window>

