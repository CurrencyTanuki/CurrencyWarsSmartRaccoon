<Window x:Class="CurrencyWarsAssistant.App.StartupNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用声明"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Border Margin="18"
            Padding="22"
            CornerRadius="10"
            Background="{StaticResource PanelBrush}">
        <StackPanel>
            <TextBlock FontSize="21"
                       FontWeight="SemiBold"
                       Text="免费使用与源码授权说明" />
            <TextBlock Margin="0,14,0,0"
                       FontSize="14"
                       LineHeight="23"
                       TextWrapping="Wrap"
                       Text="本软件由项目官方免费提供，不收取软件购买费。若你从任何渠道付费购买，请向商家申请退款，并从项目官方发布页获取。" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="#B7C7D9"
                       LineHeight="21"
                       TextWrapping="Wrap"
                       Text="本项目源代码公开，依据 CC BY-NC-SA 4.0 许可（署名-非商业性使用-相同方式共享）查看与修改：需保留版权声明、注明原作者，禁止任何商业用途，修改后的衍生作品须以相同许可分享。本许可不属于标准定义下的“完全开源”许可。风险提示：本工具使用截图识别与模拟输入，不读取游戏内存、不修改游戏文件，但任何第三方辅助工具均存在被游戏运营方检测与处罚的风险，请知悉并自担风险使用。" />
            <Border Margin="0,16,0,0"
                    Padding="12,10"
                    CornerRadius="6"
                    Background="#111A28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="#8498AF" Text="QQ 交流群" />
                    <TextBlock Grid.Column="1"
                               FontWeight="SemiBold"
                               Text="{Binding QqGroupDisplay}" />
                    <TextBlock Grid.Row="1"
                               Margin="0,7,0,0"
                               Foreground="#8498AF"
                               Text="官方网站" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,7,0,0"
                               FontWeight="SemiBold"
                               Text="{Binding OfficialWebsiteDisplay}" />
                </Grid>
            </Border>
            <Button Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="OnContinueClick"
                    Content="了解并继续" />
        </StackPanel>
    </Border>
</Window>
