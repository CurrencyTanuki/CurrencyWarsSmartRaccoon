<Window x:Class="CurrencyWarsAssistant.App.OperationPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CurrencyWarsAssistant.App"
        Title="货币战争历史数据看板"
        Width="600"
        Height="620"
        MinWidth="500"
        MinHeight="540"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <DropShadowEffect x:Key="TextShadow"
                          BlurRadius="2"
                          Direction="270"
                          Opacity="0.9"
                          ShadowDepth="1"
                          Color="#FF000000" />
        <Style x:Key="DashboardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF5F7FA" />
            <Setter Property="Effect" Value="{StaticResource TextShadow}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColumnHeading" TargetType="TextBlock" BasedOn="{StaticResource DashboardText}">
            <Setter Property="Foreground" Value="#FFC4CCD8" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock" BasedOn="{StaticResource DashboardText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ChartTitle" TargetType="TextBlock" BasedOn="{StaticResource DashboardText}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ChartScale" TargetType="TextBlock" BasedOn="{StaticResource DashboardText}">
            <Setter Property="Foreground" Value="#FFAEBCCB" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Border x:Name="PanelBorder"
            Margin="2"
            Padding="8"
            CornerRadius="9"
            Background="#EC111722"
            BorderBrush="#D6E7B85A"
            BorderThickness="1.2"
            Opacity="{Binding LogOverlayOpacity}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="360" />
                <RowDefinition Height="*" />
                <RowDefinition Height="29" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DragHandle"
                           Grid.Column="0"
                           Style="{StaticResource DashboardText}"
                           Foreground="#FFD9B85F"
                           FontSize="16"
                           FontWeight="Bold"
                           Text="⋮⋮"
                           ToolTip="拖动历史数据看板" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource DashboardText}"
                           FontSize="14"
                           FontWeight="Bold"
                           Text="节点历史" />
                <Button x:Name="DetailedHistoryButton"
                        Grid.Column="2"
                        Height="21"
                        Padding="9,1"
                        VerticalAlignment="Center"
                        Foreground="#FFF1F3F5"
                        Background="Transparent"
                        BorderBrush="#80F4F6F8"
                        BorderThickness="1"
                        FontSize="9.5"
                        Cursor="Hand"
                        Content="详细历史"
                        ToolTip="查看当前对局全部已收集信息"
                        Click="OnDetailedHistoryClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,1,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource DashboardText}"
                           Foreground="#FFBFD7EE"
                           FontSize="10.5"
                           Text="{Binding DashboardSummaryText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DashboardSummaryText}" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           Style="{StaticResource DashboardText}"
                           FontSize="9"
                           ToolTip="节点完美通关状态图例">
                    <Run Foreground="#FF75DB91" FontWeight="Bold" Text="✓完美" />
                    <Run Foreground="#FFFF9B62" FontWeight="Bold" Text=" !未完美" />
                    <Run Foreground="#FF9AA8B6" FontWeight="Bold" Text=" ?未知" />
                </TextBlock>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0"
                        Margin="0,0,3,3"
                        Padding="5,3"
                        CornerRadius="5"
                        Background="#641C2735"
                        BorderBrush="#505F7083"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource ChartTitle}"
                                       Foreground="#FF66D5F4"
                                       Text="最终伤害" />
                            <TextBlock Style="{StaticResource ChartScale}"
                                       Text="{Binding DashboardDamageScaleLabel}" />
                        </Grid>
                        <ScrollViewer x:Name="DamageChartScroller"
                                      Grid.Row="1"
                                      Focusable="True"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnChartMouseWheel">
                            <local:DashboardTrendChart IsHitTestVisible="False"
                                                       ItemsSource="{Binding DashboardRows}"
                                                       Metric="FinalDamage"
                                                       ScaleLabel="{Binding DashboardDamageScaleLabel}"
                                                       Stroke="#FF5FC9E8" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        Margin="3,0,0,3"
                        Padding="5,3"
                        CornerRadius="5"
                        Background="#641C2735"
                        BorderBrush="#505F7083"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource ChartTitle}"
                                       Foreground="#FFF1A0E7"
                                       Text="阵容理论出伤极限" />
                            <TextBlock Style="{StaticResource ChartScale}"
                                       Text="{Binding DashboardTheoryScaleLabel}" />
                        </Grid>
                        <ScrollViewer x:Name="TheoryChartScroller"
                                      Grid.Row="1"
                                      Focusable="True"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnChartMouseWheel">
                            <local:DashboardTrendChart IsHitTestVisible="False"
                                                       ItemsSource="{Binding DashboardRows}"
                                                       Metric="TheoreticalDamage"
                                                       ScaleLabel="{Binding DashboardTheoryScaleLabel}"
                                                       Stroke="#FFF09AE5" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Margin="0,3,3,0"
                        Padding="5,3"
                        CornerRadius="5"
                        Background="#641C2735"
                        BorderBrush="#505F7083"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource ChartTitle}"
                                   Foreground="#FFFFD16A"
                                   Text="金币" />
                        <ScrollViewer x:Name="GoldChartScroller"
                                      Grid.Row="1"
                                      Focusable="True"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnChartMouseWheel">
                            <local:DashboardTrendChart IsHitTestVisible="False"
                                                       ItemsSource="{Binding DashboardRows}"
                                                       Metric="AbsoluteGold"
                                                       ScaleLabel="线性"
                                                       Stroke="#FFFFCC63" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Margin="3,3,0,0"
                        Padding="5,3"
                        CornerRadius="5"
                        Background="#641C2735"
                        BorderBrush="#505F7083"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource ChartTitle}"
                                   Foreground="#FF78DEA1"
                                   Text="剩余行动值" />
                        <ScrollViewer x:Name="ActionChartScroller"
                                      Grid.Row="1"
                                      Focusable="True"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="OnChartMouseWheel">
                            <local:DashboardTrendChart IsHitTestVisible="False"
                                                       ItemsSource="{Binding DashboardRows}"
                                                       Metric="RemainingAction"
                                                       ScaleLabel="线性"
                                                       Stroke="#FF75DB91" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,5,0,0"
                    CornerRadius="5"
                    Background="#4A18212C"
                    BorderBrush="#465B6B7D"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="#791F2A38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeading}" Text="节点" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeading}" Text="最终伤害" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeading}" Text="理论极限" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeading}" Text="行动" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeading}" Text="金币" />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeading}" Text="奖励" />
                        <TextBlock Grid.Column="6" Style="{StaticResource ColumnHeading}" Text="完美" />
                        <TextBlock Grid.Column="7" Style="{StaticResource ColumnHeading}" Text="血量Δ" />
                    </Grid>
                    <ScrollViewer x:Name="TableScroller"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="True">
                        <ItemsControl ItemsSource="{Binding DashboardRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder"
                                            MinHeight="22"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="45" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="44" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource CellText}"
                                                       Foreground="#FFFFD36E"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding NodeId}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource CellText}"
                                                       Text="{Binding FinalDamageDisplay}" />
                                            <TextBlock Grid.Column="2"
                                                       Style="{StaticResource CellText}"
                                                       Foreground="#FFF1B1E9"
                                                       Text="{Binding TheoreticalDamageDisplay}" />
                                            <TextBlock Grid.Column="3"
                                                       Style="{StaticResource CellText}"
                                                       Text="{Binding RemainingActionDisplay}" />
                                            <TextBlock Grid.Column="4"
                                                       Style="{StaticResource CellText}"
                                                       Foreground="#FFFFD97A"
                                                       Text="{Binding AbsoluteGoldDisplay}" />
                                            <TextBlock Grid.Column="5"
                                                       Style="{StaticResource CellText}"
                                                       Foreground="#FFFFD97A"
                                                       Text="{Binding GoldRewardDisplay}" />
                                            <TextBlock Grid.Column="6"
                                                       FontWeight="Bold"
                                                       Text="{Binding PerfectClearDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                        <Setter Property="Foreground" Value="#FF9AA8B6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PerfectClearState}" Value="Perfect">
                                                                <Setter Property="Foreground" Value="#FF75DB91" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PerfectClearState}" Value="Failed">
                                                                <Setter Property="Foreground" Value="#FFFF9B62" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="7"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding HealthDeltaDisplay}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                                        <Setter Property="Foreground" Value="#FF9AA8B6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HealthDeltaState}" Value="Positive">
                                                                <Setter Property="Foreground" Value="#FF75DB91" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HealthDeltaState}" Value="Negative">
                                                                <Setter Property="Foreground" Value="#FFFF7F72" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HealthDeltaState}" Value="Neutral">
                                                                <Setter Property="Foreground" Value="#FFCCD5DF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Border.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NodeId, StringFormat=节点：{0}}" />
                                                <TextBlock Text="{Binding DataQualityDisplay, StringFormat=数据质量：{0}}" />
                                                <TextBlock Text="{Binding GoldRewardDisplay, StringFormat=结算奖励：{0}}" />
                                            </StackPanel>
                                        </Border.ToolTip>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="#304A5868" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                        <Setter Property="Background" Value="#3AC69B3D" />
                                                        <Setter Property="BorderBrush" Value="#80D4AF52" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,5,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,6,0"
                           Style="{StaticResource DashboardText}"
                           Foreground="#FFBCC6D2"
                           FontSize="10"
                           Text="透明度" />
                <Slider Grid.Column="1"
                        VerticalAlignment="Center"
                        Minimum="0.25"
                        Maximum="1"
                        TickFrequency="0.05"
                        Value="{Binding LogOverlayOpacity, Mode=TwoWay}" />
                <CheckBox x:Name="ClickThroughToggle"
                          Grid.Column="3"
                          Width="15"
                          Height="15"
                          Margin="8,0,5,0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsLogOverlayClickThrough, Mode=TwoWay}"
                          ToolTip="开启后整张看板均不拦截点击；请从主窗口或全局热键关闭穿透" />
                <TextBlock Grid.Column="4"
                           Style="{StaticResource DashboardText}"
                           Foreground="#FFD6DEE8"
                           FontSize="10"
                           Text="鼠标穿透" />
            </Grid>

            <ResizeGrip Grid.Row="4"
                        Margin="0,0,-7,-7"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Foreground="#FFD9B85F" />
        </Grid>
    </Border>
</Window>
